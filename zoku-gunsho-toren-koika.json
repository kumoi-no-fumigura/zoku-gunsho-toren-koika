 "poems": [
  {
   "seq": "1",
   "text": "あふ坂をなにゝいそきてこえにけん末に名こその関も有けり",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "分かねて超えける人も有物をうき身をくれに又知すらん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "風吹はおきつしらすにをる波のまなく契しかひもなき哉",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "忘らるゝ我身のみこそから衣なにかは人をうら見しもせん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "果くはかりなけかし物をにし木々のたてなからたに朽なましかは",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "もろともにつく〳〵とせしかねことの人はらへにも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "なかれてとたきめし物を水のうへのあはれや人にしられたけり",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "た地よりていく世のほともへ忍物をぬしたえにけりしつのしけ原",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "かりにたに音信ぬかなおほあら犬の森の草とや我になりにし",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "君をこそ忘れわひぬれいまゝさせくも仕へや恋のかきり成らん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "きみかこしなかやの道も草むしてとふふすはかり故にけるかな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "おもひきやうれしくとけし下ひもにはては根をむすふへしとは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "人心かゝらん物と思ひせはうちたれかみもあけそあはまし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "いまはらになそやつれなきいにしへに我身やかへる人やその人",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "ひまもなくかゝる涙も有物をあたにたえにし人にみせはや",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "なやうとてすきんことこそかたかたあらめ見しかとたにもなむしき哉",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "忘らるゝ我身をのみや恨へ丈わするゝ人のつらからぬかは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "ありつゝも又も屋あふとおもはすはおしかるへくもなき我身かな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "かねてよりかゝらむ物と思ひせはあくれはおきし露ときえなまし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "なをやさはほのめかさまし花すゝ花すゝき人の心にあきははつとも",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "我屋あらぬんやはかはるわすられしあふ書ことに契しはたそ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "忘らるゝいまこそうけれいにしへはなつさひてこそ過し身なれと",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "夢に雀にありしかことく夜もすから伏あかしつと見るよしもかな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "我にのみつれなく見えて誰に又思ひつくまのなへつくるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "うき人にうしおほゝえむ人もかなおもひしらせて思ひしられん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "しのゝめのそてにたまひて山かつらはなるゝにこそ遥としりぬれ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "夜とゝもにぬれのみわたるおもとかなり中のしみつ思ひ出れは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "そのまゝにまたこそ家はうちふ御ね異誰とか新枕する",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "あさからすたのみわたりてよものをなとたえにけん堀川の水",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "心こそ猶ひかれけれおもえすにうたてふりにしたつか弓哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "みさこゐるすまの入江にみつしほのからしや人にわするゝ身は",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "いかて我見そのまゝはゐならすともい戸へたひもよそなから見ん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "うかりける人の心をしらすけのおひの世まて登契けるかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "〽思はしとおもふ思ひをおもひにて思ひ走えせぬ思ひとそする",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "いひそかし時に中々うかりせはなさけなしとてやみもしなまし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "しらるゝ身をつみてこそしられけれ我忘治し人のなけきは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "きみかこと思ひつゝ遣てさぬる夜は涙にうかふすけのをまくら",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "心をはくたかし物を始より岩ねのこ松ねはかたかりせは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "風はやみあさちかすゑのしら露やあたなる人の心なるらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "人しれすせぬはさ〳〵をせし中に何をか君は思ひ出らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "いとはるゝ身にも光らはぬ心かななにとて人のくるしかるらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "今見こむゆつのつまゝしさしもよに我も思ふ人もいてこし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "思ひいつ屋あふことかたのにつせかひはなれかたくて直し昔を",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "霊とわかとよさかまくらせし時に閑くなけかしき事や立けん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "とし月はへたて行ともつらかりしその面かけは身をもはなれす",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "しかすかに何をか人もいとわましかきを忘れるはいのち成とは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "千とせまて葉かへぬ松もある物を程なくかはるこゝろなりけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "おもはむとつく〳〵いひしことの葉は忘草とやはやなりにける",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "かひなくてやみにしをたになけく身に恋しさをたきそへてける哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "さりともととふのすかこもみふにねて猶ならふをはあきてこそまて",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "あのしのち誰にか君はつき草のはなめかしくて世をすくすらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "思はぬをおもふといかておもふへきしられおかくわすれぬそうき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "うたてにも思ひはなれぬ心かなさはかりんはふりすつれとも",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "〽我からとんのつらさもおほえつゝかこつかたなきねをのこそなく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "わすらるゝ我も心のある物をわすかゝ人をなそやとすれぬ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "我ために霊はあたこの山なれや見ねはなけきのしけりのみゆく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "うし時もありし物をとゆふされは思ひやりつゝねをのみそなく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "数ならぬ身はくもり夜の月なれや思はれてのみやみぬと思へは",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "むすひつる契そつらきともかくもんをは今はいはしろのまつ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "あふことを又もやとこそまづは山かひなくならんと屋は思はし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "面かけは見しまゝにこそかはらぬにこゝろしもおとあらすなるらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "いかにせん涙に袖のくつとてもつゝむはかりのうれしけもなし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "さらしなと契し物をはひもなく我をはすての山のはそうき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "恋してふことの葉のみそ年をへて秋はくれとも恋やかはらぬ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "思ひこそとをくもならめみちのくにのしのふとたにもしらせてし哉",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "夕くれとたのめてをきし暁の袖堂に露はひまもなかりき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "春されはやふらのきらすうちとけてねたくそ人にしられにける",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "思ひ出れはあひ見し程の月日廿へとをさかり行ことのかなしき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "難波かたなみすにおふるあしのねのふしならひけん身をそ恨る",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "夢にたに又もやみると夜もすからかへすころ毛のうらめしの身や",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "もろともにへし年月のいかなれは我のみならの都なからん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "我なかにたれせき山をつくりけん近江をよそき見るそかなしき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "七夕をもときし中を七夕にもとかるはかり成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "おもひきやあま夜のはに吹かせのめにさえ見へすならん物とは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "一漕はなれやへのしほちに行舟のほのかに走にも見るほとのなみ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "わすれゆく人をもいはしうかりける身の徳のみそ思ひしらるゝ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "ふた葉さすに井くさまゆのこはいかにゆくへもしらすかきたえにけん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "いそせめてなにか恋しきつうかりしすかたは今もかはらし物を",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "思ひきやふせやにたつるかやり火のかはかり我をいとふへしとは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "かれ〳〵にとふもの葉のなり行は我なかにたに霜屋おくらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "つく〳〵とやきすゑぬしのおしへけんむすふの神のしるしたになし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "うとむらん人の心をうとすれてかとまるゝ身のうとましきかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "忘らるゝ我身はさもやおほかたのよさへあやなくうらめしき哉哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "見しや夢わかれやうつゝうつことも夢ともえこそ思ひさためね",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "忘れ行人のこゝろはつらからて思ひもしらぬ身をそうらむる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "数ならぬ身をうくしまのこはいかに契しかひもおき世なるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "衣手にひまなくかゝるしら露は君や形見におきて別し",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "見し人を忍ふの岡の花すゝきなひくはまねく心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "二人ねてふたりねたりとみし夢はひたりなはに有ける物を",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "うちはらふ袖にもあまる涙哉ひとりぬる夜のところせきかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "一枯はつる草の下葉の露遣さは我身のうへになりける物を",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "うつゝにてかゝらん中とおもひさやきらぬ別はあるせなれとも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "うしとのみ思ひなるほのひとつ松又たとひなきなけきをそする",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "一月日きへへたつる中と成にけりすきまを置きもあらせ屋はせし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "いまこそは思ひあはすれあふことのうれしかりしにくやしかりけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "うしといひ恋ひしといへは君中へに心のならぬゝそ見しける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "しはるゝ身をいつかたにかくさまし世の中おらぬ世の中もかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "何事をおもひさはりてたえに遣む我身はこまの関ならなくに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "よそに人とりてもなをしつらきかなありし心はいつちいにけん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "見つくきのねを見てたにしのはれむうき我身こそ住にくしとも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "ほとゝき奇待し月日をなかねとも今日こそ我は初音聞つれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733909",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  }
 ],
